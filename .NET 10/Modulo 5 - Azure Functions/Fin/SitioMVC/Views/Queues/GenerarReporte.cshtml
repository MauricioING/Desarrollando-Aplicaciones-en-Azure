@{
    ViewData["Title"] = "Enviar Correo";
}

<h2>Enviar Correo</h2>

<form id="form-reporte">
    <div class="form-group mb-3">
        <label class="form-label">Correo</label>
        <input id="correoUsuario" name="correoUsuario" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Enviar</button>
</form>

<div id="resultado" class="mt-3"></div>

<a id="enlace-reporte" class="d-none btn btn-primary">Descargue el reporte haciendo click aquí</a>

@section Scripts {
    <script>

        let pollingHabilitado = false;
        let reporteId = null;
        const resultDiv = document.getElementById("resultado");

        function hacerPollingResultados(){
            setInterval(() => {
                if (!pollingHabilitado){
                    return;
                }

                console.log('haciendo polling...');
                obtenerEstatusReporte();

            }, 1000)
        }

        async function obtenerEstatusReporte(){
            console.log('obtenerEstatusReporte...');

            const response = await fetch(`api/${reporteId}`, {
                method: "GET",
                headers: {
                    "Content-Type": "application/json"
                }
            });

            if (response.ok) {
                const json = await response.json();
                if (json.reporteEstatus === 2){
                    pollingHabilitado = false;
                    resultDiv.innerHTML = `<div class="alert alert-success">Reporte generado.</div>`;

                    const enlace = document.getElementById('enlace-reporte');
                    enlace.href =  json.reporteURL;
                    enlace.classList.remove('d-none');
                }

            } else {
                resultDiv.innerHTML = `<div class="alert alert-danger">Error al obtener estatus de reporte</div>`;
            }

        }

        document.getElementById("form-reporte").addEventListener("submit", async function (e) {
            e.preventDefault();

            const correo = document.getElementById("correoUsuario").value;

            console.log(correo);

            const response = await fetch("@Url.Action("GenerarReporte")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(correo)
            });



            if (response.ok) {
                const json = await response.json();
                console.log(json);
                pollingHabilitado = true;
                reporteId = json.id;
                hacerPollingResultados();
                resultDiv.innerHTML = `<div class="alert alert-success">Reporte solicitado correctamente. Por favor espere...</div>`;
            } else {
                resultDiv.innerHTML = `<div class="alert alert-danger">Error al generar el reporte</div>`;
            }
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
}
