@model PersonaCrearDTO

@{
    ViewData["Title"] = "Crear Persona";
}

<h2>Crear Persona</h2>

<form asp-action="Crear" method="post">
    <div class="form-group mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="FechaNacimiento" class="form-label"></label>
        <input asp-for="FechaNacimiento" type="date" class="form-control" />
        <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Foto" class="form-label"></label>
        <input asp-for="Foto" type="file" class="form-control" />
        <span asp-validation-for="Foto" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Crear</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
