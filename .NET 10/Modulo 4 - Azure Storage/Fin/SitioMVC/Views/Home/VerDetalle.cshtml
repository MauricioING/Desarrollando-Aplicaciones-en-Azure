@model Persona

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<h1>Ver detalle persona: @Model.Nombre</h1>

<h4>Perfiles</h4>

<a class="btn btn-primary" href="/home/CrearPerfil/@Model.Id">Crear perfil</a>


@if (Model.Perfiles is not null && Model.Perfiles.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Idioma</th>
                <th>Modo oscuro</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var perfil in Model.Perfiles)
            {
                <tr>
                    <td>@perfil.Idioma</td>
                    <td>@perfil.ModoOscuro</td>
                    <td>
                        <a class="btn btn-primary"
                           asp-controller="Home" asp-action="ModificarPerfil"
                           asp-route-id="@Model.Id"
                           asp-route-rowkey="@perfil.RowKey">Editar</a>

                        <a class="btn btn-danger"
                           asp-controller="Home" asp-action="BorrarPerfil"
                           asp-route-id="@Model.Id"
                           asp-route-rowkey="@perfil.RowKey">Borrar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No hay perfiles para mostrar...</p>
}