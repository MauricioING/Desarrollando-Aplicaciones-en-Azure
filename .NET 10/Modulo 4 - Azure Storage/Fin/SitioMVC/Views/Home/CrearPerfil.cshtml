@model PerfilPersona

@{
    ViewData["Title"] = "Crear Perfil";
}

<h2>Crear Perfil</h2>

<form asp-action="CrearPerfil" method="post">
    <input type="hidden" asp-for="PartitionKey" />
    <input type="hidden" asp-for="RowKey" />

    <div class="form-group mb-3">
        <label asp-for="Idioma" class="form-label"></label>
        <input asp-for="Idioma" class="form-control" />
    </div>

    <div class="form-check">
        <input asp-for="ModoOscuro" class="form-check-input" type="checkbox">
        <label class="form-check-label" for="ModoOscuro">
            Modo Oscuro
        </label>
    </div>

    <button type="submit" class="btn btn-primary">Crear</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
